# Copy to .env.local and fill in. Never commit real values.

# --- Mongo (same database the bot uses: achivator_bot) ---
MONGODB_URI=mongodb://localhost:27017

# --- Telegram ---
# Same bot token the bot runs with; validates WebApp initData signatures.
TELEGRAM_BOT_TOKEN=123456:replace_with_bot_token

# --- Backend voucher signer (ed25519) ---
# 32-byte hex seed. MUST equal BACKEND_SECRET in ton-contracts/.env: the
# contracts verify voucher signatures against the backend public key that was
# baked into DistributorMaster at deploy time.
# Generate a pair once: npx blueprint run genBackendKey
BACKEND_SECRET=

# --- TON ---
# DistributorMaster address. NEXT_PUBLIC_* is exposed to the browser;
# MASTER_ADDRESS is the optional server-side fallback for the same value.
NEXT_PUBLIC_MASTER_ADDRESS=
MASTER_ADDRESS=
NEXT_PUBLIC_TON_NETWORK=testnet
# Optional: defaults to https://testnet.toncenter.com (or https://toncenter.com on mainnet).
TONCENTER_URL=
# Optional: keyless access works but is rate-limited to ~1 rps.
TONCENTER_API_KEY=

# --- Rewards / fees ---
# Default points -> jetton conversion applied when a claim voucher is issued.
# Chat creators can set their own price per chat in the mini app (pool page);
# this rate applies to every chat that has not.
JETTONS_PER_POINT=0.01
# Published deposit fee table (JSON array, matched against chat member count).
# Advisory: no on-chain cap, the backend-signed fee is enforced as-is.
FEE_TIERS=[{"minMembers":0,"tier":0,"feeTon":"0.1"},{"minMembers":1000,"tier":1,"feeTon":"0.5"},{"minMembers":10000,"tier":2,"feeTon":"1"}]

# --- Dev only ---
# Outside production, skips initData validation and acts as this Telegram user.
DEV_TELEGRAM_USER_ID=

# Default maturation period for new points, in days (0-30). Chat creators
# can override it per chat in the mini app (claim rules).
MATURATION_DAYS=3

# --- Achievement NFTs (optional; minting stays off until both are set) ---
# From ton-contracts: npx blueprint run deployAchievementRegistry
ACHIEVEMENT_REGISTRY=
# From ton-contracts: npx blueprint run registerTemplates (prints this JSON)
ACHIEVEMENT_TEMPLATES=

# Optional: gateway for ipfs:// jetton metadata URIs (default https://ipfs.io/ipfs/).
IPFS_GATEWAY=
